# Makes all cd calls use the ll alias to lists files below the directory we moved to the way I like it.
cdl() {
  cd "$@" && ll
}

# Allows to create a directory and change to it. Have never used it.
mkcd() {
  mkdir -p "$1" && cdl "$1"
}

check_git() {
  local SEARCH_DIR=~
  echo "Scanning for git repos in $SEARCH_DIR..."

  find "$SEARCH_DIR" \( \
    -path "$HOME/.local" -o \
    -path "$HOME/.cache" -o \
    -path "$HOME/.cargo" -o \
    -path "$HOME/.nvm" -o \
    -path "$HOME/.config/nvm" -o \
    -path "$HOME/.Trash" -o \
    -path "/timeshift" \
    \) -prune -false -o -type d -name ".git" 2>/dev/null | while read -r gitdir; do
    repo_dir="$(dirname "$gitdir")"
    if git -C "$repo_dir" rev-parse --is-inside-work-tree &>/dev/null; then
      git_status=$(git -C "$repo_dir" status --porcelain --untracked-files=no)
      ahead=$(git -C "$repo_dir" rev-list @{u}..HEAD 2>/dev/null | wc -l | tr -d ' ')

      if [[ -n "$git_status" || "$ahead" -ne 0 ]]; then
        echo "→ $repo_dir"
        [[ -n "$git_status" ]] && echo "$git_status" | sed 's/^/   /'
        [[ "$ahead" -ne 0 ]] && echo "   Unpushed commits: $ahead"
      fi
    fi
  done
}

# Measure the startup time of the shell (default: $SHELL) by running it 10 times.
# Uses '/usr/bin/time' to track execution time.
# The shell starts in interactive mode (-i) but only executes 'exit' (-c exit).
timezsh() {
  local shell=${1:-$SHELL}                    # Use the provided shell or default to $SHELL
  repeat 10 /usr/bin/time "$shell" -i -c exit # Run the timing test 10 times
}

# --- Git workflow helpers ---

get_merged_and_existing_features() {
  local quiet=false
  local detailed=false
  local tag_depth=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --quiet)
      quiet=true
      shift
      ;;
    --detailed)
      detailed=true
      shift
      ;;
    --tag-depth)
      tag_depth="$2"
      shift 2
      ;;
    *) shift ;;
    esac
  done

  local latest_tag=""
  if [[ "$tag_depth" -gt 0 ]]; then
    latest_tag=$(git describe --tags --abbrev=0 --skip=$((tag_depth - 1)) 2>/dev/null)
  fi

  local range="HEAD"
  if [[ -z "$latest_tag" ]]; then
    [[ "$quiet" == false ]] && echo -e "\033[33mNo tags found or tags ignored. Scanning all history...\033[0m"
  else
    [[ "$quiet" == false ]] && echo -e "\033[36mScanning merges since tag: $latest_tag\033[0m"
    range="${latest_tag}..HEAD"
  fi

  # 1. Collect and deduplicate branch names from merge commits
  local branches
  branches=$(git log "$range" --merges --format="%s" |
    sed -n "s/Merge branch '\(.*\)' into.*/\1/p" |
    sort -u)

  # 2. Iterate and verify existence
  while IFS= read -r branch_name; do
    [[ -z "$branch_name" ]] && continue

    local is_excluded=false
    case "$branch_name" in
    main | master | develop) is_excluded=true ;;
    esac

    local exists=""
    if [[ "$is_excluded" == false ]]; then
      exists=$(git branch --list "$branch_name")
    fi

    if [[ -n "$exists" ]]; then
      if [[ "$quiet" == true ]]; then
        echo "$branch_name"
      else
        echo -e "\033[32m[ACTIVE] $branch_name\033[0m"
      fi
    elif [[ "$detailed" == true && "$quiet" == false ]]; then
      echo -e "\033[90m[DELETED] $branch_name\033[0m"
    fi
  done <<<"$branches"
}

end_branch() {
  local current_branch
  current_branch=$(git rev-parse --abbrev-ref HEAD)

  if [[ "$current_branch" == "main" ]]; then
    echo "Already on main branch, nothing to end." >&2
    return 1
  fi

  git add .
  git commit

  git push origin "$current_branch"

  git checkout main
  git pull origin main
  git merge "$current_branch"

  git push origin main

  git branch -d "$current_branch"
  git push origin --delete "$current_branch"

  echo -e "\033[32mBranch '$current_branch' has been merged into main and deleted locally & remotely.\033[0m"
}

# Courtesy of https://stackoverflow.com/questions/30590083/git-how-to-rename-a-branch-both-local-and-remote
rename_branch() {
  if [[ $# -ne 2 ]]; then
    echo "Usage: rename_branch <old> <new>" >&2
    return 1
  fi
  local old="$1"
  local new="$2"
  local remote="origin"

  # Rename the local branch to the new name
  git branch -m "$old" "$new"

  # Delete the old branch on remote
  git push "$remote" --delete "$old"

  # Prevent git from using the old name when pushing in the next step.
  git branch --unset-upstream "$new"

  # Push the new branch to remote
  git push "$remote" "$new"

  # Reset the upstream branch for the new_name local branch
  git push "$remote" -u "$new"
}
